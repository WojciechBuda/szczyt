# Copy to .env (never commit the real file). Values: Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key only. NEVER put the secret / service_role key in the frontend.
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Optional: public URL of the deployed site. Used as the target of links in
# confirmation e-mails. Defaults to the current origin, so it is usually not needed.
# VITE_SITE_URL=https://your-site.workers.dev
